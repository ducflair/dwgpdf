{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/npm", { "tarballDir": ".release-assets" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/prepare-release.mjs ${nextRelease.version}",
        "publishCmd": "cargo publish --allow-dirty"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": ".release-assets/*.tgz", "label": "npm package" },
          { "path": ".release-assets/*.crate", "label": "Rust crate" }
        ]
      }
    ]
  ]
}
