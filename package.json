{
  "name": "dwgpdf",
  "version": "0.1.0",
  "description": "Convert DXF, DWG, and DWF drawings to PDF",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "pkg",
    "README.md",
    "LICENSE",
    "index.d.ts"
  ],
  "main": "./pkg/dwgpdf.js",
  "module": "./pkg/dwgpdf.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./pkg/dwgpdf.js"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target bundler --no-default-features --out-dir pkg --release && node -e \"const fs = require('node:fs'); for (const file of ['pkg/.gitignore', 'pkg/package.json', 'pkg/README.md', 'pkg/LICENSE']) fs.rmSync(file, { force: true })\"",
    "prepack": "npm run build:wasm",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  }
}
